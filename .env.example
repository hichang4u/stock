# ── KIS API ──────────────────────────────────────────────────────────
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
# Account env priority: KIS_ACCT_NO/KIS_ACCT_CD override KIS_ACCOUNT_NO/KIS_ACCOUNT_TYPE.
# Use one pair only in normal operation; KIS_ACCOUNT_* is the documented default.
# Empty KIS_ACCT_* values do not fall back; they are treated as invalid configuration.
KIS_ACCOUNT_NO=12345678-01
KIS_ACCOUNT_TYPE=01
# KIS_ACCT_NO=12345678-01
# KIS_ACCT_CD=01

# PAPER: 모의투자 / REAL: 실계좌
KIS_MODE=PAPER
# REAL 전환값: KIS_MODE=REAL
# 주의: docs/REAL_TRADING_CHECKLIST.md의 REAL-BLOCKER가 모두 해소되기 전에는
# 위 값을 REAL로 변경하지 마세요.

# 모의투자
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_WS_URL=ws://ops.koreainvestment.com:31000

# REAL 전환값: 위 모의투자 URL 두 줄을 아래 값으로 교체
# KIS_BASE_URL=https://openapi.koreainvestment.com:9443
# KIS_WS_URL=ws://ops.koreainvestment.com:21000
# REAL에서는 실전용 KIS_APP_KEY/KIS_APP_SECRET과 실계좌 KIS_ACCOUNT_NO를 사용

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── 시스템 ───────────────────────────────────────────────────────────
# STOCK_SKIP_DOTENV is reserved for the pytest harness. Do not set it in
# production: a process-level value of 1 prevents main and API smoke scripts
# from loading .env. It is intentionally not defined as an operator setting here.
NTP_SERVER=time.google.com,time.windows.com,kr.pool.ntp.org
LOG_DIR=data/logs
STATE_DIR=data/state
PARAMS_DIR=data/params
AUTH_DIR=data/auth
DB_DIR=data/db

# Read-only auth. When on, this tree never issues, caches, or revokes a KIS
# token -- it only reads a cache another tree wrote. Leave it unset and the
# tree role (.stock-role) decides: a dev tree defaults to read-only so a shared
# AUTH_DIR cannot be clobbered. Set 0 to let a dev tree issue its own token
# (needed once production switches to REAL -- see the separation design, 6-5).
# KIS_AUTH_READONLY=1

# Safe end-to-end simulation. When enabled, the app skips KIS auth/API/orders
# and WebSocket, then runs F1->F4 with deterministic sample data.
DRY_RUN=0
# REAL 필수값: DRY_RUN=0
# 실전투자 준비도는 100%일 때만 REAL 시작/매수 주문을 허용한다.
REAL_READINESS_MIN_PAPER_TRADES=20
# 아래 값은 실제 점검·훈련을 마친 뒤에만 1로 변경한다.
# 선언만으로 게이트를 우회하면 계좌 안전을 보장할 수 없다.
REAL_CONFIG_VERIFIED=0
REAL_SMOKE_TEST_APPROVED=0
REAL_ALERT_TEST_APPROVED=0
REAL_OPERATOR_DRILL_APPROVED=0
# REAL 지정가 왕복 스모크에서 사용할 당시 F1 적격(갭 2% 이상 10% 미만) 종목.
# 실행 직전에 지정하며 상주 전략 설정으로 사용하지 않는다.
# REAL_SMOKE_TICKER=005930
DRY_RUN_TICKER=005930
DRY_RUN_PREV_CLOSE=10000
DRY_RUN_EXPECTED_PRICE=10300
DRY_RUN_EXPECTED_QTY=500000
DRY_RUN_ENTRY_PRICE=10300
DRY_RUN_ENTRY_QTY=10
DRY_RUN_STEP_DELAY=0.2
DRY_RUN_LOG_DIR=data/dry_run/logs
DRY_RUN_STATE_DIR=data/dry_run/state
DRY_RUN_DB_DIR=data/dry_run/db

# KIS OAuth/WebSocket auth request timeouts. Connect timeout is slightly longer
# to absorb transient morning gateway/DNS delays before the retry loop runs.
KIS_AUTH_CONNECT_TIMEOUT_SEC=15.0
KIS_AUTH_READ_TIMEOUT_SEC=10.0
KIS_AUTH_WRITE_TIMEOUT_SEC=10.0
KIS_AUTH_POOL_TIMEOUT_SEC=5.0

# KIS REST calls are serialized at this interval to avoid per-second limits.
# Leave unset to use the KIS_MODE-based default:
#   REAL=0.20 (5/sec, limit 18/sec), PAPER=1.1 (~0.9/sec, limit 1/sec as of 2026-04-20).
# KIS_RATE_INTERVAL_SEC=0.20
# REAL 권장값: 미설정(코드가 0.20 적용) 또는 KIS_RATE_INTERVAL_SEC=0.20
KIS_MAX_TRANSIENT_RETRIES=2
KIS_TRANSIENT_RETRY_BASE_SEC=1.0
KIS_TRANSIENT_RETRY_MAX_SEC=8.0

# 매도 POST 응답 유실 시 주문시각·종목·수량으로 KIS 주문내역을 대사한다.
# 일치 주문이 하나로 확정되지 않으면 재주문하지 않고 EXITING을 유지한다.
EXIT_RECONCILE_ATTEMPTS=3
EXIT_RECONCILE_INTERVAL_SEC=0.5

# F1 expected quote enrichment concurrency. Keep this modest for KIS rate limits.
F1_GAP_MIN=0.025
F1_GAP_CORE_MAX=0.080
F1_GAP_HARD_MAX=0.100
F1_MIN_EXPECTED_AMOUNT=100000000
F1_HIGH_GAP_MIN_EXPECTED_AMOUNT=5000000000
F1_SELECTION_TOP_PCT=0.10
F1_MIN_CANDIDATES=10
F1_EXPECTED_QUOTE_CONCURRENCY=1
# REAL 초기 권장값: F1_EXPECTED_QUOTE_CONCURRENCY=1
# 실전 호출 제한을 별도로 검증하기 전에는 동시성을 높이지 마세요.

# Pause between KOSPI and KOSDAQ F1 ranking calls to avoid KIS burst limits.
F1_MARKET_INTERVAL_SEC=3.0
F1_RETRY_INTERVAL_SEC=5

# PAPER-only observation probe. It records pre-open ranking/multi-price behavior
# and the 09:00 order-book boundary without changing candidates or sending orders.
PAPER_FAST_PROBE=0
# REAL 필수값: PAPER_FAST_PROBE=0
PAPER_FAST_PROBE_DIR=data/paper_fast_probe
PAPER_FAST_PROBE_OPEN_OFFSET_MS=300
PAPER_FAST_PROBE_OPEN_MAX_LATENESS_MS=2500
PAPER_FAST_PROBE_OPEN_TIMEOUT_SEC=2.5
PAPER_FAST_SHADOW=1
PAPER_FAST_SHADOW_TOP_N=30
PAPER_FAST_SHADOW_REQUIRED_DAYS=10
PAPER_FAST_SHADOW_SCAN_FILE_LIMIT=32
# Shadow 결과 검증 후 PAPER에서만 1로 전환. REAL에서는 코드가 항상 차단한다.
PAPER_FAST_HYBRID=0
F3_FAST_RECHECK_MAX_AGE_SEC=15
# Pre-order single-quote recheck for opening-transition stale quotes (antc<=0,
# stck_oprc<=0, current==prev close). Max 3 attempts, 0.5s apart, hard total
# wall-clock budget <= 5s (includes each inquire-price call and sleeps).
F3_RECHECK_MAX_ATTEMPTS=3
F3_RECHECK_RETRY_DELAY_SEC=0.5
F3_RECHECK_TOTAL_BUDGET_SEC=5.0
BALANCE_SNAPSHOT_TTL_SEC=90
BALANCE_SNAPSHOT_PREFETCH=1

# F3 entry timing and retry policy. First entry is always sent immediately after F3 final pick. Default sizing uses 95% orderable cash,
# then checks each limit fill for F3_LIMIT_FILL_TIMEOUT_SEC seconds. Unfilled orders
# retry until F3_ENTRY_RETRY_DEADLINE. Pyramid timing is retained for compatibility; the runtime
# FIRST_RATIO constant is 1.00, so no second buy is placed and F3_PYRAMID_AT is skipped.
# Use less than 100% to leave market-order and fee headroom.
F3_ALLOC_RATIO=0.95
# REAL 전환 시: 0.95를 그대로 사용하지 말고 승인된 소액 위험 비율로 낮추세요.
# 계좌 규모와 허용 손실액에 따라 달라지므로 공통 REAL 값은 제공하지 않습니다.
# ENTRY_QTY_CLAMPED is INFO below this reduction and WARN at/above it.
F3_QTY_CLAMP_WARN_PCT=20.0
F3_ENTRY_MAX_ATTEMPTS=2
F3_ENTRY_RETRY_DELAY_SEC=0.5
F3_ENTRY_CANCEL_RELEASE_WAIT_SEC=1.5
# When a cancel is rejected, re-poll the fill for this window before retrying the cancel
# (a rejected cancel usually means the order already filled). Must exceed the fill-query
# lag: measured inquire-daily-ccld round trips are 0.7-3.3s, so a 2.0s window could not
# complete a single query on a slow day and always came back empty.
F3_ENTRY_CANCEL_CONFIRM_FILL_SEC=6.5
F3_ENTRY_RETRY_DEADLINE=09:11:00
# 현재는 shadow 계측 전용이며 초과해도 주문을 차단하지 않는다.
F3_ENTRY_TOTAL_BUDGET_SEC=45.0
# Pre-entry VI check: switch candidates immediately; wait only without an
# alternative and below the gap cap, then revalidate the final quote and gap.
F3_VI_CHECK_ENABLED=1
F3_VI_RELEASE_WAIT_SEC=130.0
F3_VI_RELEASE_POLL_SEC=2.0
F3_PRE_ORDER_QUIET_SEC=1.5
F3_ASK_SLIPPAGE_RATIO=0.01
F3_QUOTE_MOVE_WARN_PCT=1.5
F3_FINAL_QUOTE_MAX_AGE_MS=1500
# REAL 권장값: F3_FINAL_QUOTE_MAX_AGE_MS=500
F3_LIMIT_FILL_TIMEOUT_SEC=2.0
# Entry audit DB writes are best-effort and never delay live fill/cancel handling
# beyond this bound. The durable state file remains the primary recovery ledger.
F3_ENTRY_AUDIT_TIMEOUT_SEC=0.25
F3_PYRAMID_AT=09:10:40

# Early/manual entries: keep collecting prices after close until this time.
# CLOSED observations never run stop logic or send orders.
# DRY_RUN uses deterministic synthetic ticks and stops after its simulated close.
F4_POST_CLOSE_OBSERVE_UNTIL=09:10
F4_REST_BACKUP_ENABLED=1
F4_REST_ONLY_WHEN_WS_STALE=1
F4_WS_STALE_SEC=2.0
F4_REST_POLL_INTERVAL_SEC=1.0
F4_WS_HEALTH_LOG_COOLDOWN_SEC=60.0
TRAILING_SHADOW_ENABLED=1
TRAILING_SHADOW_BASELINE_TRAIL=0.015
# CLOSED 상태는 기본 WS-only. 차트 보강용 REST가 필요할 때만 1로 활성화.
F4_POST_CLOSE_REST_BACKUP_ENABLED=0
F4_POST_CLOSE_REST_POLL_INTERVAL_SEC=30.0
F4_HEARTBEAT_INTERVAL_SEC=30.0
KIS_LATENCY_SUMMARY_INTERVAL_SEC=60.0
KIS_LOW_PRIORITY_MAX_WAIT_SLOTS=25

# 0단계 계측: 체결된 PAPER 한 종목의 재생 가능한 가격 경로를 진입~15:15까지
# gzip JSONL로 durable 기록한다(관측 전용, 주문 경로와 분리). PAPER에서만 동작.
STRATEGY_TICK_CAPTURE_ENABLED=1
STRATEGY_TICK_DIR=data/strategy_ticks
# 캡처 경로 완전성 전용 사후 REST 백업(09:35~15:14, 저우선). 차트 보강용
# F4_POST_CLOSE_REST_BACKUP_ENABLED와 별개 스위치다.
STRATEGY_TICK_REST_BACKUP_ENABLED=1
# 압축 후 일 용량 소프트 한도(MB). 초과해도 기록을 버리지 않고 경고만 남긴다.
STRATEGY_TICK_SOFT_LIMIT_MB=100
